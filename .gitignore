**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Backend (Iteration 1 frame extraction) runtime artifacts
backend/storage/
backend/__pycache__/
backend/.venv/

# Gradle build caches (anywhere, including vendored plugins)
**/.gradle/

# IDE specific files
.idea/
*.iml
.vscode/

# Local secrets (never commit)
.env
backend/.env

# Local profile database (per-device demo data, not source)
backend/profiles.db
